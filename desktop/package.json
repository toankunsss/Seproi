{
  "name": "sep-roi-desktop",
  "productName": "Whip Boss",
  "version": "1.0.0",
  "description": "Whip Boss — taskbar idle game",
  "author": "Whip Boss",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "shot": "electron . --shot",
    "icon": "node ../tools/brand/make-brand.cjs",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.whipboss.game",
    "productName": "Whip Boss",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "extraResources": [
      { "from": "..", "to": "game", "filter": ["index.html", "icon.svg", "css/**", "js/**", "fonts/**"] }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "minimumSystemVersion": "10.15",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "WhipBoss-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Whip Boss ${version}",
      "artifactName": "WhipBoss-${version}-mac-${arch}.${ext}"
    },
    "portable": { "artifactName": "WhipBoss-${version}-portable.exe" },
    "nsis": {
      "artifactName": "WhipBoss-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Whip Boss"
    }
  }
}
